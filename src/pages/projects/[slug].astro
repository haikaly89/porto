---
// src/pages/projects/[slug].astro
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

// Pastikan ini sesuai dengan mode yang Anda inginkan (true untuk SSG, false untuk SSR)
export const prerender = false;

const { slug } = Astro.params;
const entry = await getEntry('projects', slug);

if (!entry) {
  return Astro.redirect('/404');
}

const { Content } = await render(entry);

// Mengambil Hero Image dengan cara yang lebih aman
const heroImage = entry.data.cover || null;
---

<BaseLayout title={entry.data.title} wide={true}>
  <div class="max-w-5xl mx-auto mt-10 mb-20 px-4">
    <a href="/projects" class="group inline-flex items-center text-sm font-medium text-gray-500 hover:text-blue-600 dark:text-gray-400 dark:hover:text-blue-400 mb-8">
      <span class="mr-2">←</span> Back to Projects
    </a>

    <header class="grid grid-cols-1 lg:grid-cols-2 gap-12 mb-16 items-start animate-fade-in">
      <div class="order-2 lg:order-1">
        <div class="flex flex-wrap gap-2 mb-6">
          {entry.data.tags?.map((tag: string) => (
            <span class="px-3 py-1 text-xs font-semibold uppercase bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 rounded-full">
              {tag}
            </span>
          ))}
        </div>
        
        <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 dark:text-white mb-6">
          {entry.data.title}
        </h1>

        <p class="text-xl text-gray-600 dark:text-gray-300 mb-8">
          {entry.data.summary}
        </p>

        {entry.data.repository && (
          <div class="mt-8">
            <a href={entry.data.repository} target="_blank" class="inline-flex items-center px-6 py-3 rounded-xl bg-gray-900 text-white dark:bg-white dark:text-gray-900">
              View on GitHub
            </a>
          </div>
        )}
      </div>

      {heroImage && (
        <div class="order-1 lg:order-2 flex justify-center">
            <div class="relative rounded-2xl overflow-hidden shadow-2xl">
                <img src={heroImage} alt={entry.data.title} class="object-cover w-full h-auto" />
            </div>
        </div>
      )}
    </header>

    <div class="bg-white dark:bg-[#1c1e26] rounded-3xl md:p-10">
        <article class="prose prose-lg dark:prose-invert max-w-none">
          <Content />
        </article>
    </div>
  </div>
</BaseLayout>

<style>
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in {
        animation: fadeIn 0.8s ease-out forwards;
    }
</style>