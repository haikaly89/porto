---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry, getCollection } from 'astro:content';

// 1. Ambil Data Profil
const profile = await getEntry('profile', 'data');
const { 
  name = "Nama Belum Diisi", 
  role = "Role Belum Diisi", 
  bio = "", 
  avatar, 
  location 
} = profile ? profile.data : {};

// 2. Ambil Data CV (untuk Experience)
const cv = await getEntry('cv', 'data');

// 3. Ambil Data Projects
const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);

// 4. Ambil Data Blog dari Hashnode (Limit 3)
const query = `
  query GetRecentPosts {
    publication(host: "haikaly-0.hashnode.dev") {
      posts(first: 3) {
        edges {
          node {
            title
            slug
            publishedAt
          }
        }
      }
    }
  }
`;

let latestPosts = [];
try {
  const response = await fetch("https://gql.hashnode.com", {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      "Authorization": import.meta.env.HASHNODE_TOKEN,
    },
    body: JSON.stringify({ query }),
  });
  
  const result = await response.json();
  if (result.data?.publication?.posts?.edges) {
    latestPosts = result.data.publication.posts.edges.map(edge => edge.node);
  } else {
    console.log("Homepage: No posts found or API error", result);
  }
} catch (error) {
  console.error("Homepage: Error fetching posts:", error);
}
---

<BaseLayout title={name}>
  
  <section class="grid grid-cols-1 sm:grid-cols-[1fr_auto] gap-8 mb-16 items-center sm:items-start text-center sm:text-left">
    
    <div class="col-span-1">
      <h1 class="text-4xl font-bold text-gray-900 dark:text-white mb-2">{name}</h1>
      <p class="text-gray-600 dark:text-gray-400">{role}</p>
    </div>

    <div class="w-48 mx-auto sm:mx-0 sm:col-start-2 sm:row-span-2 relative flex-shrink-0">
      <div class="relative group">
        <div class="absolute -inset-1 bg-gradient-to-r from-blue-600 to-purple-600 rounded-lg blur opacity-25 group-hover:opacity-75 transition duration-200"></div>
        <img 
          src={avatar || "https://placehold.co/400"} 
          alt={name} 
          class="relative w-full h-auto rounded-lg shadow-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 object-cover aspect-square"
        />
      </div>
      {location && <p class="text-center text-xs text-gray-500 mt-2">{location}</p>}
    </div>

    <div class="col-span-1">
      <div class="prose prose-sm dark:prose-invert text-gray-700 dark:text-gray-300 leading-relaxed mb-6 mx-auto sm:mx-0">
         {bio.split('\n').map((line) => line.trim() && (
            <p class="text-justify mb-2">{line}</p>
         ))}
      </div>

      <div class="flex gap-5 text-3xl mt-4 items-center justify-center sm:justify-start">
        <a href="https://github.com/haikaly89" target="_blank" aria-label="GitHub Profile" class="text-gray-500 hover:text-[#333] dark:text-gray-400 dark:hover:text-white transition-colors">
           <i class="fa-brands fa-github"></i>
        </a>
        <a href="https://www.linkedin.com/in/haikal-yusuf/" target="_blank" aria-label="LinkedIn Profile" class="text-gray-500 hover:text-[#0077b5] dark:text-gray-400 dark:hover:text-[#0a66c2] transition-colors">
           <i class="fa-brands fa-linkedin"></i>
        </a>
      </div>
    </div>

  </section>

  {/* SECTION 2: Latest Posts (Moved Up) */}
  {latestPosts.length > 0 && (
    <section class="mb-16">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">Latest Posts</h2>
      <div class="flex flex-col gap-4">
        {latestPosts.map(post => (
          <a href={`/blog/${post.slug}`} class="group flex flex-col sm:flex-row justify-between items-baseline hover:bg-gray-100 dark:hover:bg-[#2b2d35] p-3 -mx-3 rounded-lg transition">
            <span class="text-sm text-gray-500 font-mono w-32 shrink-0 mb-1 sm:mb-0">
              {new Date(post.publishedAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}
            </span>
            <span class="text-gray-700 dark:text-gray-300 font-medium group-hover:text-blue-600 dark:group-hover:text-blue-400 transition flex-1">
              {post.title}
            </span>
          </a>
        ))}
      </div>
      <div class="mt-4">
          <a href="/blog" class="text-sm font-bold text-blue-600 dark:text-blue-400 hover:underline">
              View All Posts →
          </a>
      </div>
    </section>
  )}

  {/* SECTION 3: Featured Projects */}
  {sortedProjects.length > 0 && (
    <section class="mb-16">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">Featured Projects</h2>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
        {sortedProjects.map(project => (
          <a href={`/projects/${project.slug}`} class="flex flex-col h-full bg-white border border-gray-200 dark:bg-black dark:border-gray-800 p-6 rounded-2xl hover:shadow-xl dark:hover:border-gray-600 transition group">
            
            <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-3 leading-tight group-hover:text-blue-600 dark:group-hover:text-blue-400 transition">
              {project.data.title}
            </h3>
            
            <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed mb-8 flex-1 line-clamp-3">
              {project.data.summary}
            </p>
            
            <div class="flex justify-between items-end mt-auto pt-4 border-t border-transparent dark:group-hover:border-gray-800 transition">
              <span class="text-sm font-bold text-gray-900 dark:text-white flex items-center gap-2 group-hover:underline">
                  View Project <i class="fa-solid fa-arrow-right text-xs transition-transform group-hover:translate-x-1"></i>
              </span>
              <div class="text-gray-400 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition">
                <i class="fa-solid fa-code text-lg"></i>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  {/* SECTION 4: Experience / Journey */}
  <section class="grid grid-cols-1 md:grid-cols-2 gap-12 mb-16">
    <div class="flex flex-col justify-center bg-white/50 dark:bg-black/20 backdrop-blur-md border border-gray-200/50 dark:border-gray-700/30 p-8 rounded-3xl shadow-lg">
      <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white mb-4 leading-tight">
        The Journey So Far
      </h2>
      <p class="text-gray-600 dark:text-gray-300 text-sm mb-6 leading-relaxed">
        I combine expertise in physical and cloud infrastructure, network security, and AI solutions. My goal is to build strong, resilient systems and contribute to real technological innovation.
      </p>
      <div>
        <a href="https://www.linkedin.com/in/haikal-yusuf/" target="_blank" class="inline-flex items-center gap-2 bg-gray-900 text-white dark:bg-white dark:text-black border-2 border-transparent hover:scale-105 font-bold py-3 px-6 rounded-xl shadow-lg hover:shadow-xl transition-all active:scale-95">
          <i class="fa-brands fa-linkedin"></i> Check Full Profile
        </a>
      </div>

      <div class="mt-8 border-t border-gray-200/30 pt-6">
        <p class="text-sm font-bold text-gray-900 dark:text-white uppercase tracking-wider mb-2">Technical Expertise</p>
        <p class="text-gray-600 dark:text-gray-300 text-sm leading-relaxed">
          <span class="font-semibold text-blue-600 dark:text-blue-400">Programming:</span> Python, Bash Scripting, SQL <br/>
          <span class="font-semibold text-blue-600 dark:text-blue-400">Infra & Virtualization:</span> Docker & Containerization, KVM/QEMU <br/>
          <span class="font-semibold text-blue-600 dark:text-blue-400">Networking:</span> Routing, Switching, TCP/IP <br/>
          <span class="font-semibold text-blue-600 dark:text-blue-400">Cyber Security:</span> Network Security, Vulnerability Assessment, Linux Security Hardening, Traffic Analysis & Monitoring <br/>
          <span class="font-semibold text-blue-600 dark:text-blue-400">Other:</span> IoT, Web Development
        </p>
      </div>
    </div>

    <div class="space-y-6 max-h-[600px] overflow-y-auto pr-4 [&::-webkit-scrollbar]:w-2 [&::-webkit-scrollbar-track]:bg-transparent [&::-webkit-scrollbar-thumb]:bg-gray-200 dark:[&::-webkit-scrollbar-thumb]:bg-gray-700 [&::-webkit-scrollbar-thumb]:rounded-full hover:[&::-webkit-scrollbar-thumb]:bg-gray-300 dark:hover:[&::-webkit-scrollbar-thumb]:bg-gray-600 transition-colors">
      {cv && cv.data.experience && cv.data.experience.map((job, index) => (
        <div class="bg-white dark:bg-[#1a1c23] p-6 rounded-2xl border border-gray-200 dark:border-gray-800 shadow-sm relative overflow-hidden group hover:shadow-md transition-shadow shrink-0">
          <div class="flex justify-between items-start mb-4">
            <span class="font-bold text-gray-800 dark:text-gray-200 text-sm bg-gray-100 dark:bg-gray-800 px-3 py-1 rounded-full">
              {job.date.split('|')[0].trim()}
            </span>
            <div class="w-10 h-10 rounded-full border border-gray-200 dark:border-gray-700 flex items-center justify-center bg-white dark:bg-gray-800 shrink-0">
               <span class="font-bold text-lg text-blue-600">{job.company.charAt(0)}</span>
            </div>
          </div>
          
          <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-1 leading-tight group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
            {job.position}
          </h3>
          <p class="text-blue-600 dark:text-blue-400 font-medium text-sm mb-4">{job.company}</p>
          
          <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed line-clamp-3">
            {job.highlights[0]}
          </p>
        </div>
      ))}
    </div>
  </section>

</BaseLayout>
