---
// src/pages/blog/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';

export const prerender = false;

const query = `
  query GetUserArticles {
    publication(host: "haikaly-0.hashnode.dev") {
      posts(first: 10) {
        edges {
          node {
            title
            brief
            slug
            publishedAt
          }
        }
      }
    }
  }
`;

const response = await fetch("https://gql.hashnode.com", {
  method: "POST",
  headers: {
    "Content-Type": "application/json",
    "Authorization": import.meta.env.HASHNODE_TOKEN,
  },
  body: JSON.stringify({ query }),
});

const result = await response.json();

// DEBUGGING: Lihat ini di terminal VS Code Anda
if (result.errors) {
  console.log("ERROR DARI HASHNODE:", result.errors);
}

const posts = result.data?.publication?.posts?.edges || [];
console.log("JUMLAH ARTIKEL DITEMUKAN:", posts.length);
---

<BaseLayout title="Blog Archive">
  <h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-8">All Blog Posts</h1>
  
  {posts.length > 0 ? (
    <div class="grid gap-8">
      {posts.map(({ node }) => (
        <a href={`/blog/${node.slug}`} class="block p-6 bg-white border border-gray-200 dark:bg-[#2b2d35] dark:border-transparent rounded-xl hover:border-gray-400 dark:hover:border-gray-500 transition group">
          
          {node.coverImage?.url && (
              <img src={node.coverImage.url} alt={node.title} class="w-full h-48 object-cover rounded-lg mb-4" />
          )}

          <h2 class="text-xl font-bold text-gray-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 mb-2">
            {node.title}
          </h2>
          
          <p class="text-gray-500 text-sm mb-2">
            {new Date(node.publishedAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
          </p>

          <p class="text-gray-600 dark:text-gray-400 mb-4 line-clamp-2">
              {node.brief}
          </p>
          
          <p class="text-blue-600 dark:text-blue-400 font-medium">
            Read more →
          </p>
        </a>
      ))}
    </div>
  ) : (
    <div class="p-8 text-center bg-gray-50 dark:bg-gray-800 rounded-xl border-2 border-dashed border-gray-200 dark:border-gray-700">
      <p class="text-gray-600 dark:text-gray-400">Belum ada postingan yang ditemukan di haikaly.hashnode.space. <br/>Cek terminal untuk log debugging.</p>
    </div>
  )}
</BaseLayout>