---
// src/pages/blog/[slug].astro
import BaseLayout from '../../layouts/BaseLayout.astro';

export const prerender = false; 

const { slug } = Astro.params;

const query = `
  query GetPost($slug: String!) {
    publication(host: "haikaly-0.hashnode.dev") {
      post(slug: $slug) {
        title
        content { html }
        coverImage { url }
      }
    }
  }
`;

const response = await fetch("https://gql.hashnode.com", {
  method: "POST",
  headers: {
    "Content-Type": "application/json",
    "Authorization": import.meta.env.HASHNODE_TOKEN,
  },
  body: JSON.stringify({ 
    query,
    variables: { slug } 
  }),
});

const result = await response.json();

// Coba ambil post, jika null ambil staticPage
const postData = result.data?.publication?.post;
const pageData = result.data?.publication?.staticPage;

const contentItem = postData || pageData;

if (!contentItem) {
  return Astro.redirect('/404');
}
---

<BaseLayout title={contentItem.title}>
  <article class="prose dark:prose-invert prose-lg mx-auto mt-10 mb-20 prose-img:max-h-[500px] prose-img:w-auto prose-img:mx-auto prose-img:rounded-xl prose-img:shadow-lg">
    
    <header class="mb-10 text-center border-b border-gray-200 dark:border-gray-800 pb-8">
      {contentItem.coverImage?.url && (
          <img src={contentItem.coverImage.url} alt={contentItem.title} class="w-full max-h-[400px] object-cover rounded-xl shadow-md mb-8" />
      )}
      <h1 class="text-4xl font-bold text-gray-900 dark:text-white mb-4">{contentItem.title}</h1>
      {contentItem.publishedAt && (
        <p class="text-gray-600 dark:text-gray-400 text-sm">
            Published on {new Date(contentItem.publishedAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
        </p>
      )}
    </header>

    <div class="text-gray-700 dark:text-gray-300 leading-relaxed" set:html={contentItem.content.html} />

    <div class="mt-16 pt-8 border-t border-gray-200 dark:border-gray-800 text-center">
      <a href="/blog" class="text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 hover:underline">
        ← Back to Blog
      </a>
    </div>

  </article>
</BaseLayout>